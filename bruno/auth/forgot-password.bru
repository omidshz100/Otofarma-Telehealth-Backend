meta {
  name: Forgot password
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/auth/forgot-password
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{deviceEmail}}"
  }
}

script:post-response {
  const data = res.getBody();
  if (data && data.reset_token) {
    bru.setVar("resetToken", data.reset_token);
  }
}
