meta {
  name: Login device
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{deviceEmail}}",
    "password": "{{devicePassword}}"
  }
}

script:post-response {
  const data = res.getBody();
  if (data && data.access_token) {
    bru.setVar("deviceToken", data.access_token);
  }
}
