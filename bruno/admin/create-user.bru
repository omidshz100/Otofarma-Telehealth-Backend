meta {
  name: Create user
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/users
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Giulia",
    "role": "Pharmacy",
    "gmail": "{{deviceEmail}}",
    "gmail_password": "gmail-pass-123",
    "app_password": "{{devicePassword}}",
    "app_ids": ["{{appId}}"]
  }
}

script:post-response {
  const data = res.getBody();
  if (data && data.id) {
    bru.setVar("userId", data.id);
  }
}
